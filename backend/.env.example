# SmartRoadAI System Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development  # Use "production" for live deployment
DEBUG=false             # Disable debug mode in production

# MongoDB Configuration (Supports local and MongoDB Atlas)
MONGODB_URI=mongodb://localhost:27017
DATABASE_NAME=smartroadai

# ML Model Settings
YOLO_MODEL_PATH=ml/weights/best.pt

# Storage configurations
UPLOAD_DIR=uploads

# Security & Authentication Settings
# Generate a cryptographically strong 32+ byte hex key, e.g., with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=your-32-byte-secret-key-goes-here-replace-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=15

# Permitted CORS Origins (comma-separated without trailing slashes)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
